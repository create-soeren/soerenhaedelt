{
  "name": "soerenhaedelt",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "npm run fonts && astro dev",
    "build": "npm run fonts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "lint:js": "eslint src/scripts",
    "lint:html": "html-validate -c .htmlvalidate.json \"dist/**/*.html\"",
    "check": "npm run lint:css && npm run lint:js && npm run build && npm run lint:html",
    "prepare": "simple-git-hooks",
    "fonts": "node scripts/fonts.mjs",
    "spiel": "node scripts/spiel.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "html-validate": "^11.21.0",
    "postcss-html": "^2.0.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}

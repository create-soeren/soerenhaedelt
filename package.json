{
  "name": "soerenhaedelt",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "import:cases": "node scripts/import-cases.mjs",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "lint:html": "html-validate -c .htmlvalidate.json \"dist/**/*.html\"",
    "check": "npm run lint:css && astro build && npm run lint:html",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "html-validate": "^11.21.0",
    "postcss-html": "^2.0.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}

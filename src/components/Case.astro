---
// Ein Case aus der Collection. Markup und Klassen wie im Prototyp (renderCase und BLOCKS), vom Server gebaut.
import Evidence from "./Evidence.astro";
import Pic from "./Pic.astro";
import { asset } from "../lib/url";
import { poster } from "../lib/poster";

const { head, blocks } = Astro.props.data;
const of = blocks.filter((b) => b.type === "chapter").length;
const visual = head.kind === "visual";
let no = 0;
const lead = visual && head.media.video ? await poster(head.media.poster) : null;
// Breite des Bildes auf der Seite je Block (Spalten aus site.css): Kapitel rechte Spalte, Showcase je nach Anordnung.
const sizesOf = (b) => b.type === "chapter" ? "(min-width: 1020px) 52vw, 100vw"
  : b.items.length > 2 ? "(min-width: 1020px) 20vw, (min-width: 744px) 33vw, 50vw"
  : b.portrait ? "(min-width: 1020px) 300px, 50vw" : "(min-width: 1020px) 50vw, 100vw";
const num = (n) => String(n).padStart(2, "0") + " / " + String(of).padStart(2, "0");
---
<section class="case" id="case" data-page="case">
  <header class={visual ? "vhero" : undefined}>
    <p class="no"><span>Case study</span><span>{head.label}</span></p>
    {visual ? (
      <Fragment>
        <h1 class="stmt vtitle">{head.title}</h1>
        <figure>
          {head.media.video
            ? <video src={asset(`media/${head.media.video}`)} poster={lead.src} width={lead.width} height={lead.height} aria-label={head.media.alt} controls muted loop playsinline preload="metadata"></video>
            : <Pic src={head.media.poster} alt={head.media.alt} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />}
          {head.caption && <figcaption>{head.caption}</figcaption>}
        </figure>
      </Fragment>
    ) : (
      <Fragment>
        <p class="ctitle">{head.title}</p>
        <h1 class="stmt"><span class="was"><span class="sr-only">Before, struck: </span><span class="pen">{head.from}</span></span><span>{head.to}</span></h1>
      </Fragment>
    )}
    {head.impact && <Evidence e={{ kind: "stat", value: head.impact.value, label: head.impact.label }} />}
    <dl class="meta">{head.meta.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
  </header>
  {blocks.map((b) => (
    <Fragment>
      {b.type === "chapter" && (
        <article class="block decision"><div class="dhead">
          <p class="no"><span>{num(++no)}</span></p>
          {b.struck && <p class="was"><span class="sr-only">{b.struck.label}, struck: </span><span class="pen">{b.struck.text}</span></p>}
          <h2>{b.decision}</h2></div>
          <div class="dbody"><div class="why">{b.why.map((p) => <p>{p}</p>)}</div>
          {b.evidence && <div class="evidence">{b.evidence.map((e) => <Evidence e={e} sizes={sizesOf(b)} />)}</div>}</div></article>
      )}
      {b.type === "showcase" && (
        <div class:list={["block showcase", `is-${b.width}`, { "is-portrait": b.portrait, "is-row": b.items.length > 2 }]} style={`--n: ${b.items.length}`}>
          <div class="items">{b.items.map((e) => <Evidence e={e} sizes={sizesOf(b)} />)}</div></div>
      )}
      {b.type === "learnings" && (
        <article class="block decision learnings"><div class="dhead"><h2>Key learnings</h2></div>
          <ol>{b.items.map(({ title, text }) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol></article>
      )}
      {b.type === "quote" && (
        <figure class="block cquote"><Pic class="photo" src={b.photo} widths={[340, 680]} sizes="(max-width: 743px) min(280px, 60vw), 340px" alt={b.who.split(",")[0]} style={`object-position: ${b.position}`} loading="lazy" decoding="async" />
          <div><blockquote>“{b.text}”</blockquote><footer class="who">{b.who}</footer></div></figure>
      )}
    </Fragment>
  ))}
</section>

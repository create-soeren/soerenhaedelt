---
// Ein Beleg in einem Kapitel oder Showcase. Markup wie im Prototyp (EVIDENCE in renderCase).
import Pic from "./Pic.astro";
import { asset } from "../lib/url";
import { poster } from "../lib/poster";
// sizes: wie breit das Bild auf der Seite steht, kommt vom Block (Case.astro).
const { e, sizes = "100vw" } = Astro.props;
const clip = e.kind === "video" ? await poster(e.poster) : null;
---
{e.kind === "image" && (
  <figure><Pic class={e.rounded ? "device" : undefined} src={e.src} alt={e.alt} sizes={sizes} loading="lazy" decoding="async" />{e.caption && <figcaption>{e.caption}</figcaption>}</figure>
)}
{e.kind === "pair" && (
  <div class="pair">{e.items.map((i) => (
    <figure><Pic src={i.src} alt={i.alt} sizes={sizes} loading="lazy" decoding="async" />{i.caption && <figcaption>{i.caption}</figcaption>}</figure>
  ))}</div>
)}
{e.kind === "video" && (
  <figure><video src={asset(`media/${e.src}`)} poster={clip.src} width={clip.width} height={clip.height} aria-label={e.alt} controls muted loop={e.loop !== false} playsinline preload="metadata"></video>{e.caption && <figcaption>{e.caption}</figcaption>}</figure>
)}
{e.kind === "stat" && (
  <p class="stat"><b>{e.value}</b><span>{e.label.map((l, i) => <Fragment>{i > 0 && <br>}{l}</Fragment>)}</span></p>
)}
{e.kind === "compare" && (
  <div class="compare">{e.items.map((s, n) => (
    <Fragment>{n > 0 && <svg viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7 H26 M20 1 L26 7 L20 13"/></svg>}
    <p class="stat"><b>{s.value}</b><span>{s.label.map((l, i) => <Fragment>{i > 0 && <br>}{l}</Fragment>)}</span></p></Fragment>
  ))}</div>
)}
{e.kind === "quote" && (
  <div><blockquote>“{e.text}”</blockquote><p class="who">{e.who}</p></div>
)}
{e.kind === "finding" && (
  <p class="finding">{e.text}<span>{e.who}</span></p>
)}

---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import Pic from "../components/Pic.astro";
import { url } from "../lib/url";
import til from "../assets/people/til.jpg";
import khaled from "../assets/people/khaled.jpg";
import anita from "../assets/logos/anita.png";
import paxa from "../assets/logos/paxa.png";
import hdt from "../assets/logos/hdt.png";
import amendio from "../assets/logos/amendio.png";
import neptune from "../assets/logos/neptune.png";
import siliconAllee from "../assets/logos/silicon-allee.svg";
import fraunhofer from "../assets/logos/fraunhofer.svg";
// Logos: Anzeigehöhe aus site.css (--h, Standard 30 px), geladen in doppelter Höhe für scharfe Kanten.
const logos = [[anita, "Anita"], [siliconAllee, "Silicon Allee", 44], [paxa, "Paxa"], [hdt, "HDT Systems", 36], [amendio, "amendio", 24], [fraunhofer, "Fraunhofer", 34], [neptune, "neptune", 28]];
---
<Base page="home" title="Sören Hädelt">
  <section class="hero" data-page="home">
    <div class="obj-slot" aria-hidden="true"></div>
    <h1><span class="line">Complex Systems</span><span class="line">need <span class="ink" data-ink="hero">tailored</span></span><span class="line"><span class="ink" data-ink="hero">Product Design.</span></span></h1>
    <p class="lead">I judge your product from where your users stand. Then I design from there.</p>
    <!-- aria-hidden: the object is decoration beside the headline, it carries no content. -->
    <canvas id="obj3d" aria-hidden="true"></canvas>
  </section>

  <section id="anita" data-page="home">
    <h2>Concepts need to be <span class="ink eol" data-ink="anita">understood by the user.</span><br>Systems ship their value to the user<br>when the design is leading them through it.</h2>
    <p class="intro">My first client was Anita. They let me challenge their software concepts and its characteristics. Our collaboration never ended.</p>
    <div class="wins">
      <div class="win"><div class="icon" data-icon="simplify"></div><p>Radically simplified the product for the user</p></div>
      <div class="win"><div class="icon" data-icon="satisfaction"></div><p>+ <span class="num" data-to="79">79</span>% Usability Satisfaction in the first 12 weeks</p></div>
      <div class="win"><div class="icon" data-icon="customers"></div><p>From 0 to <span class="num" data-to="700">700</span> Customers</p></div>
    </div>
    <div class="actions"><a class="btn primary" href={url("cases/anita-app/")}>Read Case Study</a><a class="btn" href={url("projects/")}>Show all Case Studies</a></div>
  </section>

  <section id="quote" data-page="home">
    <div class="quotes">
      <figure class="quote is-on">
        <Pic class="photo" src={til} widths={[340, 680]} sizes="(max-width: 743px) min(280px, 60vw), 340px" alt="Til Bußmann-Welsch" style="object-position: 52% 35%" decoding="async" />
        <div>
          <blockquote>"Sören hat unser SaaS-Produkt einmal komplett auf links gedreht. Die Identifikation der Schwachstellen, wie auch der Stärken, war schonungslos ehrlich, aber genau dieser Input war nötig, um das Produkt auf das nächste Level zu heben. Sören hatte dabei immer die technische und die Businessperspektive im Blick. Die Fortschritte der letzten zwei Jahre sprechen für sich."</blockquote>
          <footer class="who">Til Bußmann-Welsch, Co-Founder Anita</footer>
        </div>
      </figure>
      <figure class="quote">
        <Pic class="photo" src={khaled} widths={[340, 680]} sizes="(max-width: 743px) min(280px, 60vw), 340px" alt="Khaled Mahd" style="object-position: 50% 12%" loading="lazy" decoding="async" />
        <div>
          <blockquote>"I've had the pleasure of working with Sören on multiple projects, including the relaunch of our website to Webflow. He handled the migration fully preserving our existing SEO visibility. His ability to anticipate risks and proactively solve complex problems made the transition smooth and stress-free. Integral work ethic and technical precision! I look forward to continuing our collaboration."</blockquote>
          <footer class="who">Khaled Mahd, Creative Director at Silicon Allee</footer>
        </div>
      </figure>
      <button class="next" id="nextQuote" type="button" aria-label="Next testimonial"><svg viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 7 H26 M20 1 L26 7 L20 13"/></svg></button>
    </div>
  </section>

  <section id="skills" data-page="home">
    <div class="logos" role="group" aria-label="Clients">
      <div class="logos-track">
        <div class="logos-set">
          {logos.map(([src, alt, h]) => <Image src={src} alt={alt} height={(h ?? 30) * 2} format={src.format === "svg" ? undefined : "webp"} quality={90} style={h ? `--h: ${h}px` : undefined} />)}
        </div>
      </div>
    </div>
    <h2>My business and frontend skills allow me<br>to&nbsp;look at products <span class="ink eol" data-ink="skills">from every perspective.</span></h2>
    <p class="intro">I have multiple years of experience in business and marketing. I switched fields, but I kept my skills.</p>
    <div class="wins">
      <div class="win"><div class="icon" data-icon="marketing"></div><p>Multiple years working experience in marketing</p></div>
      <div class="win"><div class="icon" data-icon="certificates"></div><p>Various certificates in frontend development and business</p></div>
      <div class="win"><div class="icon" data-icon="mindset"></div><p>State of mind tool using</p></div>
    </div>
  </section>
</Base>

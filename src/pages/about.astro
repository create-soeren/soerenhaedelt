---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/url";
---
<Base page="about" title="About me · Sören Hädelt">
  <section class="about" id="about" data-page="about">
    <div>
      <header>
        <h1>I'm a <span class="ink">Digital Product Designer.</span> My roots are in business, and that shapes how I decide.</h1>
      </header>
      <div class="prose">
        <p>I started in business development and marketing. Design came after. Today I have more than six years of experience with digital products, four of them in UX design.</p>
        <p>That order matters. It taught me early that a product is a chain of decisions, and every decision has a cost. So I don't start with the screen. I start with the people who use the product. I question the assumptions it was built on and design from what users actually do.</p>
        <p>My work covers the full range: user research, information architecture, interaction design, interface and brand. At Anita, a legal research platform, I've done more than deliver screens. I helped set the roadmap and made crucial product decisions together with the founders.</p>
      </div>
    </div>
    <a class="social" href="https://www.linkedin.com/in/soeren-haedelt/" target="_blank" rel="noopener" aria-label="LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="2" fill="currentColor"/><circle cx="6.6" cy="6.4" r="1.7" fill="var(--color-neutral)"/><rect x="5.1" y="9.4" width="3" height="9.6" fill="var(--color-neutral)"/><path d="M10.4 9.4h2.9v1.4c.6-1 1.7-1.7 3.2-1.7 2.5 0 3.6 1.6 3.6 4.3V19h-3v-5c0-1.3-.4-2.2-1.6-2.2-1.3 0-2.1.9-2.1 2.3V19h-3z" fill="var(--color-neutral)"/></svg></a>
    <img src={asset("assets/bildsprache-platzhalter.jpg")} alt="Portrait, placeholder">
  </section>
</Base>

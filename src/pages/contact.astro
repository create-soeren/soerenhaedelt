---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/url";
---
<Base page="contact" title="Contact · Sören Hädelt">
  <section class="cpage" id="cpage" data-page="contact">
    <img src={asset("assets/bildsprache-platzhalter.jpg")} alt="Portrait, placeholder">
    <div class="cbody">
      <h1>Let's get <span class="ink">together.</span></h1>
      <p class="intro">We can talk about your product, design or whatever is on your mind.</p>
      <!-- [ENTSCHIEDEN 2026-11-09] Ziel ist die Cal.com-Terminbuchung → daily/2026-11-09.md -->
      <div class="actions"><a class="btn primary" href="https://cal.com/create-soeren/coffee-or-tea" target="_blank" rel="noopener">Let's have a chat</a></div>
      <div class="mail-block">
        <p class="mlabel">Or send me an email</p>
        <a class="mail" href="mailto:create.soeren@gmail.com">create.soeren@gmail.com</a>
      </div>
    </div>
  </section>
</Base>

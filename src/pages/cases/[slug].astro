---
// Eine Seite pro Case, gebaut aus der Collection. Das Schema prüft jede Datei vor dem Build.
import Base from "../../layouts/Base.astro";
import Case from "../../components/Case.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { data } = Astro.props.entry;
---
<Base page="case" title={`${data.head.title} · ${data.head.label}`}>
  <Case data={data} />
</Base>

---
// Eine Seite pro Case. Vorerst nur der Titel: Das Markup kommt mit dem Port der Startseite.
// Die Route lädt die Collection schon jetzt, damit der Build auch fehlende Bilder findet.
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { head } = Astro.props.entry.data;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Bis zum Umzug auf soerenhaedelt.com nicht indexieren. -->
    <meta name="robots" content="noindex">
    <title>{head.title} · {head.label}</title>
  </head>
  <body>
    <h1>{head.title}</h1>
  </body>
</html>

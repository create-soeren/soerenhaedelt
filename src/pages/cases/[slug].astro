---
// Eine Seite pro Case, gebaut aus der Collection. Das Schema prüft jede Datei vor dem Build.
import Base from "../../layouts/Base.astro";
import Case from "../../components/Case.astro";
import { getCollection } from "astro:content";
import { poster } from "../../lib/poster";
import { checkVideo } from "../../lib/video";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { data } = Astro.props.entry;
// Poster des Hero-Videos: einmal berechnet, das Video nimmt es als poster, die Seite lädt es vorab (11h, Annahme: LCP-Kandidat).
const lead = data.head.kind === "visual" && data.head.media.video ? await poster(data.head.media.poster) : null;
if (lead && data.head.kind === "visual") checkVideo(data.head.media.video, lead);
---
<Base page="case" title={`${data.head.title} · ${data.head.label} · Sören Hädelt`} description={data.head.description}>
  {lead && <link slot="head" rel="preload" as="image" href={lead.src} fetchpriority="high" />}
  <Case data={data} lead={lead} />
</Base>
